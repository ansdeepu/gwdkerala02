{
  "name": "Ground Water Department - Government of Keralam",
  "short_name": "GWD Portal",
  "description": "Official Web Portal of Ground Water Department, Government of Keralam for deposit works, groundwater investigations, and departmental administration.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0284c7",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
